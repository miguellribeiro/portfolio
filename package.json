{
  "name": "portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "dev:studio": "vite --config vite.sites.config.ts --mode studio --port 5174",
    "dev:portfolio": "vite --config vite.sites.config.ts --mode portfolio --port 5175",
    "build:studio": "vite build --config vite.sites.config.ts --mode studio && node scripts/prerender-sites.mjs studio",
    "build:portfolio": "vite build --config vite.sites.config.ts --mode portfolio && node scripts/prerender-sites.mjs portfolio",
    "build:sites": "npm run typecheck && npm run build:studio && npm run build:portfolio",
    "preview:studio": "vite preview --config vite.sites.config.ts --mode studio --port 4174",
    "preview:portfolio": "vite preview --config vite.sites.config.ts --mode portfolio --port 4175",
    "typecheck": "tsc -p tsconfig.sites.json",
    "test:sites": "playwright test --config playwright.sites.config.ts"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "lenis": "^1.3.26",
    "motion": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.0"
  }
}
